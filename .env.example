# ==============================================================================
# ACE Education - Email Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# GMAIL SETUP (Recommended for sending from your personal or institutional Gmail)
# ------------------------------------------------------------------------------
# How to get your 16-character Google App Password:
# 1. Go to your Google Account: https://myaccount.google.com/security
# 2. Make sure 2-Step Verification is turned ON.
# 3. Go to App Passwords: https://myaccount.google.com/apppasswords
# 4. Under App name, type "ACE Website" and click Create.
# 5. Copy the 16-character code (e.g. abcd efgh ijkl mnop) and paste it below.

GMAIL_USER=
GMAIL_APP_PASSWORD=

# Display name for emails:
MAIL_FROM="ACE Admissions <your_email@gmail.com>"

# ------------------------------------------------------------------------------
# ADMISSIONS NOTIFICATION RECIPIENT
# ------------------------------------------------------------------------------
# Office email that receives a copy of all new admission leads:
ADMISSIONS_OFFICE_EMAIL=admissions@aceEduHub.com

# ------------------------------------------------------------------------------
# OPTIONAL: Alternative Providers (Resend or Custom SMTP)
# ------------------------------------------------------------------------------
# RESEND_API_KEY=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
